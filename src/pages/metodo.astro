---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Phases from '../components/Phases.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactSection from '../components/ContactSection.astro';
import { journey, promise } from '../data/method';
import detailPhoto from '../assets/photos/sala-reunioes.jpg';
---
<Base
  title="O Nosso Método"
  description="Do primeiro contacto ao acompanhamento depois do serviço: conheça a experiência Fada Madrinha, desenhada para que cada contacto seja memorável."
  darkHeader
>
  <PageHero
    tone="gold-deep"
    numeral="IV"
    kicker="O Método Fada Madrinha"
    title="Não limpamos apenas espaços. Cuidamos das pessoas que vivem neles."
    text="Acreditamos que forma uma opinião sobre nós muito antes de a equipa começar a limpar: na rapidez da resposta, na simpatia do atendimento, na pontualidade, na apresentação. Por isso, desenhámos cada passo da sua experiência."
    quote="A excelência não acontece por acaso. Ela é desenhada."
  />

  <!-- PROMESSA -->
  <section class="section--tight promise" aria-label="A promessa da marca">
    <div class="wrap promise__inner">
      <p class="kicker">O que pode esperar, sempre</p>
      <ul class="inline-list">
        {promise.map((p) => <li>{p}</li>)}
      </ul>
    </div>
  </section>

  <!-- JORNADA -->
  <section class="section" aria-labelledby="jornada-title">
    <div class="wrap split">
      <div class="split__aside">
        <p class="kicker">A sua experiência</p>
        <h2 id="jornada-title">Do primeiro contacto ao dia seguinte</h2>
        <p class="lede">Oito momentos, um só padrão. É assim que cuidamos de si.</p>
      </div>
      <ol class="ledger journey">
        {journey.map((step, i) => (
          <li class="reveal" style={`--reveal-delay:${Math.min(i, 3) * 0.05}s`}>
            <div class="ledger__row journey__row">
              <span class="numeral">{step.n}</span>
              <div>
                <p class="kicker journey__eyebrow">{step.eyebrow}</p>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
                {step.bullets && <ul class="dot-list journey__bullets">{step.bullets.map((b) => <li>{b}</li>)}</ul>}
                {step.quote && <p class="journey__quote">“{step.quote}”</p>}
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- CINCO FASES -->
  <section class="section bg-dark pattern" aria-labelledby="fases-title">
    <div class="wrap">
      <SectionHead kicker="No dia do serviço" title="Cinco fases. O mesmo padrão, sempre." text="Independentemente de quem executa, de qual o cliente ou do horário, cada serviço segue as mesmas cinco fases." />
      <Phases />
    </div>
  </section>

  <!-- PADRÃO OURO -->
  <section class="bleed bleed--left gold" aria-labelledby="ouro-title">
    <div class="bleed__media gold__media">
      <Picture src={detailPhoto} formats={['avif', 'webp']} widths={[480, 768, 1080, 1400]} sizes="(min-width: 900px) 50vw, 100vw" alt="Colaboradora a limpar com atenção a mesa de uma sala de reuniões" />
    </div>
    <div class="bleed__copy reveal">
      <p class="kicker">O Padrão Ouro</p>
      <h2 id="ouro-title">Existe apenas uma pergunta.</h2>
      <blockquote class="pull">
        <p>Se este espaço fosse meu, eu daria este serviço por terminado?</p>
        <footer>Se a resposta for não, o trabalho continua.</footer>
      </blockquote>
      <p class="gold__text">Os clientes não contratam a Fada Madrinha apenas porque limpamos bem. Contratam porque, quando terminamos, sentem que alguém cuidou da sua casa com o mesmo carinho que eles próprios teriam.</p>
    </div>
  </section>

  <CtaBand title="Mais do que limpeza, <em>uma experiência</em>." text="Peça o seu orçamento e sinta a diferença desde a primeira mensagem." />
  <ContactSection />
</Base>

<style>
  .promise { background: var(--white); border-bottom: 1px solid var(--line); }
  .promise__inner { display: grid; gap: 12px; }
  .promise .kicker { margin: 0; }
  @media (min-width: 900px) { .promise__inner { grid-template-columns: auto 1fr; align-items: center; gap: 40px; } }

  .journey__row { padding: 34px 0; }
  .journey__eyebrow { margin-bottom: 8px; font-size: 0.7rem; }
  .journey h3 { font-size: 1.4rem; margin-bottom: 10px; }
  .journey__bullets { margin-top: 14px; color: var(--ink-soft); font-size: 0.98rem; }
  .journey__quote { margin-top: 16px; padding-left: 16px; border-left: 2px solid var(--gold); font-style: italic; color: var(--ink-2) !important; max-width: 58ch; }

  .gold { background: var(--cream-2); }
  .gold__media { min-height: 360px; }
  .gold .pull { margin: 8px 0 28px; }
  .gold__text { color: var(--ink-soft); }
  @media (min-width: 900px) { .gold__media { min-height: 680px; } }
</style>
