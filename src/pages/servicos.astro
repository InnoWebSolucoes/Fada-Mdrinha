---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Faq from '../components/Faq.astro';
import ContactSection from '../components/ContactSection.astro';
import { waLink, whatsappMessages } from '../config/site';
import { services } from '../data/services';
import { faq } from '../data/faq';
import bandPhoto1 from '../assets/photos/sala-reunioes.jpg';
import bandPhoto2 from '../assets/photos/janela-escritorio.jpg';

const bands: Record<number, { src: ImageMetadata; alt: string }> = {
  1: { src: bandPhoto1, alt: 'Colaboradora a limpar com atenção a mesa de uma sala de reuniões' },
  3: { src: bandPhoto2, alt: 'Mão com luva amarela a limpar a janela de um escritório ao fim da tarde' },
};
---
<Base
  title="Serviços"
  description="Limpeza residencial, empresarial, higienização especializada, organização de espaços, pós-obra e estofos em Luanda. Conheça como trabalhamos em cada serviço."
  darkHeader
>
  <PageHero
    tone="blue-deep"
    numeral="II"
    kicker="Serviços"
    title="Seis serviços. O mesmo cuidado em todos."
    text="Cada serviço é adaptado ao seu espaço e à sua rotina. Diga-nos o que precisa e preparamos uma proposta personalizada, clara e sem letras pequenas."
  >
    <ol class="inline-list jump" aria-label="Ir para o serviço">
      {services.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
    </ol>
  </PageHero>

  <div class="services">
    {services.map((s, i) => (
      <>
        <section id={s.id} class="section svc" aria-labelledby={`${s.id}-title`}>
          <div class="wrap split">
            <div class="split__aside">
              <span class="numeral">{s.n}</span>
              <h2 id={`${s.id}-title`}>{s.title}</h2>
              <p class="lede">{s.short}</p>
            </div>
            <div class="svc__body">
              <p class="svc__long">{s.long}</p>
              <p class="kicker">Como trabalhamos</p>
              <ol class="ledger svc__steps">
                {s.steps.map((step, k) => (
                  <li><span class="num">0{k + 1}</span><span>{step}</span></li>
                ))}
              </ol>
              <a href={waLink(whatsappMessages.servico(s.title))} class="btn btn--dark" target="_blank" rel="noopener">
                <Icon name="whatsapp" /> Pedir orçamento para este serviço
              </a>
            </div>
          </div>
        </section>
        {bands[i] && (
          <div class="band" aria-hidden="true">
            <Picture src={bands[i].src} formats={['avif', 'webp']} widths={[768, 1280, 1920]} sizes="100vw" alt="" />
          </div>
        )}
      </>
    ))}
  </div>

  <!-- FAQ -->
  <section class="section bg-white" id="faq" aria-labelledby="faq-title">
    <div class="wrap split">
      <div class="split__aside">
        <p class="kicker">Perguntas frequentes</p>
        <h2 id="faq-title">Dúvidas comuns</h2>
        <p class="lede">Se a sua não estiver aqui, fale connosco. Respondemos com atenção.</p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <ContactSection
    title="Qual é o seu espaço?"
    text="Diga-nos o que precisa. Preparamos uma proposta à medida, sem compromisso."
  />
</Base>

<style>
  .jump { margin-top: 28px; }
  .jump a { color: inherit; text-decoration: none; border-bottom: 1px solid transparent; }
  .jump a:hover { border-bottom-color: currentColor; }

  .svc + .svc, .band + .svc { border-top: 1px solid var(--line-strong); }
  .svc .numeral { margin-bottom: 14px; }
  .svc__long { font-size: 1.12rem; color: var(--ink-2); max-width: 62ch; margin-bottom: 34px; }
  .svc__steps { margin-bottom: 36px; }
  .svc__steps li { display: grid; grid-template-columns: 48px 1fr; gap: 12px; padding: 16px 0; align-items: baseline; }
  .band { height: clamp(260px, 42vw, 560px); background: var(--cream-3); }
  .band :global(picture), .band :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
