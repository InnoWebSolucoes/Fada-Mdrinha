---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import ContactSection from '../components/ContactSection.astro';
import { site } from '../config/site';
import { team, principles, oath } from '../data/team';
import originPhoto from '../assets/photos/engomar-uniforme.jpg';

const essence = [
  { title: 'Confiança', text: 'Organização, profissionalismo e limpeza em cada visita, para que nos possa confiar o seu espaço sem reservas.', tone: 'blue' },
  { title: 'Excelência', text: 'Sofisticação, qualidade e valor premium. Um padrão de serviço consistente, em cada casa e em cada empresa.', tone: 'gold' },
  { title: 'Cuidado', text: 'Delicadeza e proximidade em cada detalhe. Tratamos o seu espaço como se fosse o nosso.', tone: 'pink' },
];
---
<Base
  title="Quem Somos"
  description="Conheça a história, a missão, os valores e a equipa da Fada Madrinha, limpeza profissional em Luanda com método, cuidado e confiança."
  darkHeader
>
  <PageHero
    tone="plum"
    numeral="I"
    kicker="Quem somos"
    title="Duas amigas, uma crença e uma equipa que cuida do que importa"
    text="A história, os valores e as pessoas por trás da Fada Madrinha."
  />

  <!-- ORIGEM -->
  <section class="bleed origin" aria-labelledby="origem-title">
    <div class="bleed__copy reveal">
      <p class="kicker">A nossa origem</p>
      <h2 id="origem-title">Um espaço cuidado não é um privilégio. É essencial.</h2>
      <p>
        A Fada Madrinha surge da percepção cuidadosa de duas amigas, <strong>Irina André</strong> e <strong>Nguelengue Savinona</strong>, que sempre entenderam que ter um ambiente limpo e arrumado impacta directamente a forma como vivemos e trabalhamos.
      </p>
      <p>
        O nome foi escolhido com cuidado. Assim como na narrativa, a fada madrinha aparece, realiza transformações e melhora tudo sem que ninguém precise de se preocupar com os detalhes de como isso acontece. É exactamente isso que fazemos.
      </p>
      <p>
        A ideia nasceu de uma percepção simples: os espaços em Angola precisam de um serviço de limpeza e organização que vá além do básico, com método, com cuidado e com identidade própria.
      </p>
      <p class="origin__sig">“{site.tagline}”</p>
    </div>
    <div class="bleed__media origin__media">
      <Picture
        src={originPhoto}
        formats={['avif', 'webp']}
        widths={[480, 768, 1100]}
        sizes="(min-width: 900px) 50vw, 100vw"
        alt="Colaboradora da Fada Madrinha, de uniforme azul, a engomar roupa com um sorriso numa divisão luminosa"
      />
    </div>
  </section>

  <!-- ESSÊNCIA -->
  <section class="section bg-white" aria-labelledby="essencia-title">
    <div class="wrap">
      <SectionHead kicker="A nossa essência" title="Três valores. Três cores." text="Azul para a confiança, dourado para a excelência, rosa para o cuidado. É assim que a marca se apresenta e é assim que trabalhamos." />
      <div class="cols cols--3 essence">
        {essence.map((e, i) => (
          <div class={`essence__item essence__item--${e.tone} reveal`} style={`--reveal-delay:${i * 0.08}s`}>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- MISSÃO -->
  <section class="section bg-blue-deep pattern" aria-labelledby="missao-title">
    <div class="wrap wrap--narrow mission">
      <p class="kicker kicker--center">Missão</p>
      <h2 id="missao-title">Organizamos e cuidamos dos ambientes com excelência</h2>
      <p class="lede">
        Transformamos espaços de trabalho e de vida em locais mais produtivos, acolhedores e inspiradores, para que as pessoas e as organizações concentrem o seu tempo e energia no que realmente importa.
      </p>
    </div>
  </section>

  <!-- EQUIPA -->
  <section class="section" id="equipa" aria-labelledby="equipa-title">
    <div class="wrap">
      <SectionHead kicker="A nossa equipa" title="As pessoas por trás da Fada Madrinha" text="Uma equipa pequena, próxima e comprometida com o mesmo padrão em cada serviço." />
      <div class="team">
        {team.map((m, i) => (
          <article class="team__card reveal" style={`--reveal-delay:${i * 0.08}s`}>
            <div class="photo team__photo">
              <Picture src={m.photo} formats={['avif', 'webp']} widths={[360, 540, 720]} sizes="(min-width: 900px) 380px, 90vw" alt={m.alt} />
            </div>
            <div class="team__meta">
              <h3>{m.name}</h3>
              <p class="team__role">{m.role}</p>
              <p class="team__bio">{m.bio}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PRINCÍPIOS -->
  <section class="section bg-white" aria-labelledby="principios-title">
    <div class="wrap split">
      <div class="split__aside">
        <p class="kicker">O que defendemos</p>
        <h2 id="principios-title">Princípios que orientam a nossa equipa</h2>
        <p class="lede">Uma selecção dos princípios que guiam o dia-a-dia de quem veste o uniforme da Fada Madrinha.</p>
      </div>
      <ol class="ledger">
        {principles.map((p, i) => (
          <li class="reveal" style={`--reveal-delay:${Math.min(i, 3) * 0.05}s`}>
            <div class="ledger__row">
              <span class="numeral">0{i + 1}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- JURAMENTO -->
  <section class="section bg-dark pattern" aria-label="O Juramento Fada Madrinha">
    <div class="wrap wrap--narrow">
      <blockquote class="pull reveal">
        <p>{oath}</p>
        <footer>O Juramento Fada Madrinha</footer>
      </blockquote>
    </div>
  </section>

  <CtaBand />
  <ContactSection />
</Base>

<style>
  .origin { background: var(--cream); }
  .origin p { color: var(--ink-soft); }
  .origin__sig { margin-top: 26px; font-size: 1.2rem; color: var(--gold-text) !important; }
  .origin__media { min-height: 420px; }
  @media (min-width: 900px) { .origin__media { min-height: 720px; } }

  .essence__item { border-top-width: 3px; }
  .essence__item--blue { border-top-color: var(--blue); }
  .essence__item--gold { border-top-color: var(--gold); }
  .essence__item--pink { border-top-color: var(--pink); }
  .essence h3 { font-size: 1.6rem; }

  .mission { text-align: center; }
  .mission .lede { margin-inline: auto; }

  .team { display: grid; gap: 40px; }
  .team__photo { aspect-ratio: 4 / 5; }
  .team__meta { padding-top: 18px; border-top: 1px solid var(--line-strong); margin-top: 18px; }
  .team__meta h3 { margin-bottom: 4px; font-size: 1.35rem; }
  .team__role { font-family: var(--font-label); font-size: 0.74rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold-text); font-weight: 600; margin-bottom: 10px; }
  .team__bio { color: var(--ink-soft); font-size: 0.98rem; }
  @media (min-width: 760px) { .team { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
</style>
