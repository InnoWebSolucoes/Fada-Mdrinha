---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ContactSection from '../components/ContactSection.astro';
import { waLink, whatsappMessages } from '../config/site';
import { segments, officeOrder, twentyPoints, commitments, complaintSteps } from '../data/empresas';
import kitchenPhoto from '../assets/photos/hero-cozinha.jpg';
import meetingPhoto from '../assets/photos/sala-reunioes.jpg';
---
<Base
  title="Empresas"
  description="Limpeza profissional para escritórios, clínicas, condomínios, imobiliárias, alojamento local, hotéis boutique, escolas e lojas em Luanda. Padrão operacional, supervisão e confidencialidade."
  darkHeader
>
  <PageHero
    tone="dark"
    numeral="III"
    kicker="Cliente empresarial"
    title="Uma solução personalizada para a sua empresa"
    text="A Fada Madrinha está preparada para desenvolver um plano de limpeza à medida da sua operação, garantindo elevados padrões de qualidade, discrição e pontualidade."
  >
    <div class="actions" style="margin-top: 28px">
      <a href={waLink(whatsappMessages.empresas)} class="btn btn--gold btn--lg" target="_blank" rel="noopener"><Icon name="whatsapp" /> Pedir proposta para a minha empresa</a>
    </div>
  </PageHero>

  <!-- SEGMENTOS -->
  <section class="section" aria-labelledby="segmentos-title">
    <div class="wrap">
      <SectionHead kicker="Segmentos" title="Espaços que já sabemos cuidar" text="Cada tipo de espaço tem as suas exigências. Adaptamos a frequência, a equipa e a ordem de trabalho a cada operação." />
      <ol class="cols cols--4 plain">
        {segments.map((s, i) => (
          <li class="reveal" style={`--reveal-delay:${(i % 4) * 0.05}s`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PADRÃO OPERACIONAL -->
  <section class="bleed bg-dark std" aria-labelledby="padrao-title">
    <div class="bleed__copy reveal">
      <p class="kicker">Padrão operacional</p>
      <h2 id="padrao-title">Existe uma ordem oficial. Nunca limpamos aleatoriamente.</h2>
      <p class="lede">Cada serviço realizado pela Fada Madrinha transmite exactamente a mesma qualidade, independentemente de quem o executa, do cliente ou do horário. Esse padrão chama-se Método Fada Madrinha.</p>
      <p class="kicker std__sub">Ordem de trabalho em escritórios</p>
      <ol class="ledger std__order">
        {officeOrder.map((step, i) => <li><span class="num">0{i + 1}</span><span>{step}</span></li>)}
      </ol>
      <p class="small std__note">De cima para baixo. Do mais limpo para o mais sujo. Da divisão mais distante para a saída.</p>
    </div>
    <div class="bleed__media std__media">
      <Picture src={meetingPhoto} formats={['avif', 'webp']} widths={[480, 768, 1080, 1400]} sizes="(min-width: 900px) 50vw, 100vw" alt="Equipa de limpeza a preparar uma sala de reuniões" />
    </div>
  </section>

  <!-- 20 PONTOS -->
  <section class="section bg-cream-2" aria-labelledby="pontos-title">
    <div class="wrap split">
      <div class="split__aside">
        <p class="kicker">Inspecção final</p>
        <h2 id="pontos-title">Os 20 Pontos de Excelência</h2>
        <p class="lede">Nenhum serviço termina antes desta etapa. A Fada Líder verifica cada um destes pontos antes de considerar o trabalho concluído.</p>
      </div>
      <ol class="points">
        {twentyPoints.map((p, i) => (
          <li><span class="num">{String(i + 1).padStart(2, '0')}</span>{p}</li>
        ))}
      </ol>
    </div>
  </section>

  <!-- COMPROMISSOS -->
  <section class="section bg-white" aria-labelledby="compromissos-title">
    <div class="wrap">
      <SectionHead kicker="Compromissos" title="O que a sua empresa pode esperar de nós" text="Quatro compromissos assumidos em cada contrato e medidos em cada visita." />
      <ol class="cols cols--2 plain commit">
        {commitments.map((c, i) => (
          <li class="reveal" style={`--reveal-delay:${(i % 2) * 0.07}s`}>
            <span class="numeral">0{i + 1}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- RECLAMAÇÕES -->
  <section class="section bg-blue-deep pattern" aria-labelledby="reclamacoes-title">
    <div class="wrap">
      <SectionHead kicker="Se algo correr mal" title="Uma reclamação é uma oportunidade de melhorar. Nunca um incómodo." text="Um protocolo simples, com um responsável e um prazo. Primeiro resolve-se, depois explica-se." />
      <ol class="cols cols--4 plain">
        {complaintSteps.map((s, i) => (
          <li class="reveal" style={`--reveal-delay:${i * 0.07}s`}>
            <span class="numeral">0{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PROPOSTA -->
  <section class="bleed bleed--left emp-cta" aria-labelledby="cta-emp-title">
    <div class="bleed__media emp-cta__media">
      <Picture src={kitchenPhoto} formats={['avif', 'webp']} widths={[480, 768, 1080, 1400]} sizes="(min-width: 900px) 50vw, 100vw" alt="Equipa da Fada Madrinha, de polos azuis, a limpar a copa de um escritório" />
    </div>
    <div class="bleed__copy reveal">
      <p class="kicker">Proposta comercial</p>
      <h2 id="cta-emp-title">Agradecemos a oportunidade de apresentar os nossos serviços</h2>
      <p class="lede">Envie-nos o tipo de espaço, a área aproximada e a frequência pretendida. Preparamos uma proposta clara, elegante e fácil de comparar.</p>
      <div class="actions">
        <a href={waLink(whatsappMessages.empresas)} class="btn btn--primary btn--lg" target="_blank" rel="noopener"><Icon name="whatsapp" /> Pedir proposta</a>
        <a href="/metodo" class="btn btn--ghost btn--lg">Conhecer o método</a>
      </div>
    </div>
  </section>

  <ContactSection
    title="Vamos falar sobre a sua empresa?"
    text="Fale connosco pelo WhatsApp ou e-mail. Respondemos com uma proposta institucional, clara e sem compromisso."
    message={whatsappMessages.empresas}
    tips={false}
  />
</Base>

<style>
  .plain { list-style: none; padding: 0; margin: 0; }
  .commit .numeral { margin-bottom: 6px; }

  .std__media { min-height: 380px; }
  .std__sub { margin-top: 40px; }
  .std__order li { display: grid; grid-template-columns: 44px 1fr; gap: 10px; padding: 12px 0; }
  .std__note { margin-top: 18px; color: rgba(255, 255, 255, 0.6); }
  @media (min-width: 900px) { .std__media { min-height: 720px; } }

  .points { list-style: none; padding: 0; margin: 0; display: grid; border-top: 1px solid var(--line-strong); }
  .points li { display: flex; gap: 14px; align-items: baseline; padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 1.05rem; }
  @media (min-width: 640px) { .points { grid-template-columns: 1fr 1fr; column-gap: 40px; } }

  .emp-cta { background: var(--cream-2); }
  .emp-cta__media { min-height: 360px; }
  @media (min-width: 900px) { .emp-cta__media { min-height: 620px; } }
</style>
