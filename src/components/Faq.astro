---
/** Acordeão nativo (<details>) — acessível por teclado sem JS. */
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item, i) => (
    <details class="faq__item" open={i === 0}>
      <summary class="faq__q">
        <span>{item.q}</span>
        <span class="faq__icon" aria-hidden="true"><Icon name="plus" size={20} /></span>
      </summary>
      <div class="faq__a"><p>{item.a}</p></div>
    </details>
  ))}
</div>

<style>
  .faq { display: grid; gap: 10px; }
  .faq__item { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius-sm); }
  .faq__item[open] { border-color: var(--line-strong); }
  .faq__q {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 18px 20px; cursor: pointer; list-style: none;
    font-weight: 500; font-size: 1.05rem;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__icon {
    display: grid; place-items: center; flex: none;
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--cream-2); color: var(--blue-text);
    transition: transform var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .faq__item[open] .faq__icon { transform: rotate(45deg); background: var(--gold); color: var(--ink); }
  .faq__a { padding: 0 20px 20px; color: var(--ink-soft); }
</style>
