---
import Icon from './Icon.astro';
import { site, waLink, whatsappMessages, telLink, mailLink } from '../config/site';

interface Props {
  title?: string;
  text?: string;
  message?: string;
  tips?: boolean;
}
const {
  title = 'Vamos cuidar do seu espaço?',
  text = 'Fale connosco pelo WhatsApp e receba uma proposta personalizada, clara e sem letras pequenas.',
  message = whatsappMessages.geral,
  tips = true,
} = Astro.props;
---
<section id="contacto" class="section bg-white contact" aria-labelledby="contacto-title">
  <div class="wrap split">
    <div class="contact__main reveal">
      <p class="kicker">Contacto</p>
      <h2 id="contacto-title">{title}</h2>
      <p class="lede">{text}</p>
      <div class="actions">
        <a href={waLink(message)} class="btn btn--primary btn--lg" target="_blank" rel="noopener"><Icon name="whatsapp" /> Falar no WhatsApp</a>
        <a href={mailLink} class="btn btn--ghost btn--lg">Enviar e-mail</a>
      </div>
      {tips && (
        <div class="contact__tips">
          <p class="kicker kicker--blue">Para agilizar o seu orçamento</p>
          <ul class="dot-list">
            <li>Tipo de espaço: casa, escritório, loja</li>
            <li>Localização</li>
            <li>Serviço pretendido</li>
            <li>Data desejada</li>
            <li>Fotografias do espaço, se possível</li>
          </ul>
        </div>
      )}
    </div>

    <dl class="contact__dl reveal">
      <div>
        <dt>Telefone e WhatsApp</dt>
        <dd><a href={telLink}>{site.phone.display}</a></dd>
      </div>
      <div>
        <dt>E-mail</dt>
        <dd><a href={mailLink}>{site.email}</a></dd>
      </div>
      <div>
        <dt>Instagram</dt>
        <dd><a href={site.instagram.url} target="_blank" rel="noopener">@{site.instagram.handle}</a></dd>
      </div>
      <div>
        <dt>Morada</dt>
        <dd>{site.address.display}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .contact__tips { margin-top: 40px; }
  .contact__tips .kicker { margin-bottom: 14px; }
  .contact__tips li { color: var(--ink-soft); }
  .contact__dl { margin: 0; border-top: 1px solid var(--line-strong); }
  .contact__dl > div { display: grid; gap: 4px; padding: 22px 0; border-bottom: 1px solid var(--line); }
  .contact__dl dt { font-family: var(--font-label); font-size: 0.74rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-mute); font-weight: 600; }
  .contact__dl dd { margin: 0; font-size: clamp(1.15rem, 1rem + 0.7vw, 1.5rem); }
  .contact__dl a { color: var(--ink); text-decoration: none; border-bottom: 1px solid var(--line-strong); }
  .contact__dl a:hover { color: var(--blue-text); border-color: currentColor; }
  @media (min-width: 640px) { .contact__dl > div { grid-template-columns: 200px 1fr; align-items: baseline; } }
  @media (min-width: 1024px) { .contact__dl { margin-top: 8px; } }
</style>
