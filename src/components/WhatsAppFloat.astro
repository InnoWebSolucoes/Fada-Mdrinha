---
import Icon from './Icon.astro';
import { waLink } from '../config/site';
---
<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Pedir orçamento pelo WhatsApp"><Icon name="whatsapp" size={28} /></a>

<style>
  .wa-float { position: fixed; right: 16px; bottom: 16px; z-index: 90; display: grid; place-items: center; width: 58px; height: 58px; border-radius: 50%; background: var(--whatsapp); color: var(--white); box-shadow: 0 8px 22px rgba(21, 122, 65, 0.35); transition: transform 0.35s var(--bounce); }
  .wa-float:hover { color: var(--white); transform: scale(1.1) rotate(-8deg); }
  @media (min-width: 640px) { .wa-float { right: 24px; bottom: 24px; } }
</style>
