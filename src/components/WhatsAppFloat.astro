---
import Icon from './Icon.astro';
import { waLink } from '../config/site';
---
<a class="wa-float" href={waLink()} target="_blank" rel="noopener" aria-label="Falar connosco no WhatsApp">
  <Icon name="whatsapp" size={28} />
</a>

<style>
  .wa-float {
    position: fixed; right: 18px; bottom: 18px; z-index: 90;
    display: grid; place-items: center;
    width: 58px; height: 58px;
    border-radius: 50%;
    background: var(--whatsapp);
    color: var(--white);
    box-shadow: 0 10px 28px rgba(21, 122, 65, 0.4);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .wa-float:hover { color: var(--white); transform: translateY(-2px) scale(1.04); box-shadow: 0 14px 32px rgba(21, 122, 65, 0.5); }
  .wa-float::after {
    content: ''; position: absolute; inset: 0; border-radius: 50%;
    border: 2px solid var(--whatsapp); opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wa-float::after { animation: wa-pulse 2.8s ease-out infinite; }
    @keyframes wa-pulse {
      0% { transform: scale(1); opacity: 0.7; }
      70%, 100% { transform: scale(1.55); opacity: 0; }
    }
  }
  @media (min-width: 640px) { .wa-float { right: 26px; bottom: 26px; } }
</style>
