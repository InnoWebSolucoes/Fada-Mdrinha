---
import { phases } from '../data/method';
---
<ol class="cols cols--5 phases" aria-label="As cinco fases do Método Fada Madrinha">
  {phases.map((f, i) => (
    <li class="reveal" style={`--reveal-delay:${i * 0.07}s`}>
      <span class="numeral">{f.n}</span>
      <h3>{f.title}</h3>
      <p>{f.text}</p>
    </li>
  ))}
</ol>

<style>
  .phases { list-style: none; padding: 0; margin: 0; }
  .phases h3 { font-size: 1.35rem; margin-top: 18px; }
</style>
