---
/** Faixa de CTA com o gradiente da marca (p. 3 do manual) e o símbolo em marca de água. */
import Icon from './Icon.astro';
import { waLink, whatsappMessages } from '../config/site';

interface Props { title?: string; text?: string; message?: string; secondaryHref?: string; secondaryLabel?: string }
const {
  title = 'Cuidamos do seu espaço como se fosse o nosso.',
  text = 'Peça o seu orçamento pelo WhatsApp. Respondemos com atenção e sem compromisso.',
  message = whatsappMessages.geral,
  secondaryHref = '/servicos',
  secondaryLabel = 'Ver serviços',
} = Astro.props;
---
<section class="cta-band bg-brand">
  <img src="/logo/fada-madrinha-mark.png" alt="" class="cta-band__mark" width="459" height="459" loading="lazy" decoding="async" />
  <div class="wrap cta-band__inner reveal">
    <div>
      <h2 set:html={title} />
      <p class="lede">{text}</p>
    </div>
    <div class="actions">
      <a href={waLink(message)} class="btn btn--light btn--lg" target="_blank" rel="noopener"><Icon name="whatsapp" /> Pedir orçamento</a>
      {secondaryHref && <a href={secondaryHref} class="btn btn--ghost btn--lg">{secondaryLabel}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band { position: relative; overflow: hidden; padding-block: clamp(72px, 9vw, 120px); }
  .cta-band__mark {
    position: absolute; right: -6%; top: 50%; width: clamp(280px, 36vw, 520px); height: auto;
    transform: translateY(-50%) rotate(8deg); opacity: 0.16; filter: grayscale(1) brightness(4); pointer-events: none;
  }
  .cta-band__inner { position: relative; display: grid; gap: 32px; align-items: center; }
  .cta-band h2 { max-width: 18ch; }
  .cta-band .lede { max-width: 46ch; }
  @media (min-width: 900px) { .cta-band__inner { grid-template-columns: 1.4fr 1fr; } .cta-band .actions { justify-content: flex-end; } }
</style>
