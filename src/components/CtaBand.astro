---
/** Faixa de CTA com o gradiente da marca (como a p. 3 do manual de identidade). */
import Icon from './Icon.astro';
import { waLink, whatsappMessages } from '../config/site';

interface Props {
  title?: string;
  text?: string;
  message?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}
const {
  title = 'Cuidamos do seu espaço como se fosse o nosso.',
  text = 'Peça o seu orçamento pelo WhatsApp. Respondemos com atenção e sem compromisso.',
  message = whatsappMessages.geral,
  secondaryHref = '/servicos',
  secondaryLabel = 'Ver serviços e preços',
} = Astro.props;
---
<section class="cta-band bg-brand">
  <div class="wrap cta-band__inner reveal">
    <div>
      <h2 set:html={title} />
      <p class="lede">{text}</p>
    </div>
    <div class="actions">
      <a href={waLink(message)} class="btn btn--light btn--lg" target="_blank" rel="noopener"><Icon name="whatsapp" /> Pedir orçamento</a>
      {secondaryHref && <a href={secondaryHref} class="btn btn--ghost btn--lg">{secondaryLabel}</a>}
    </div>
  </div>
</section>

<style>
  .cta-band { padding-block: clamp(56px, 8vw, 96px); }
  .cta-band__inner { display: grid; gap: 28px; align-items: center; }
  .cta-band h2 { max-width: 20ch; }
  .cta-band .lede { max-width: 48ch; }
  @media (min-width: 900px) { .cta-band__inner { grid-template-columns: 1.5fr 1fr; } .cta-band .actions { justify-content: flex-end; } }
</style>
