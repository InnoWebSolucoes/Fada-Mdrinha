---
/**
 * Roda do rato no computador: um pouco menos sensível do que o normal do browser.
 * Cada movimento da roda anda SPEED do que andaria e desliza suavemente até lá.
 * Telemóvel e ecrãs táteis ficam com o scroll nativo; zoom (ctrl + roda) e scroll lateral também.
 */
---
<script>
  const SPEED = 0.8; // 1 = como o browser; menos = menos sensível
  const desktop = matchMedia('(hover: hover) and (pointer: fine)');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let target = 0, current = 0, raf = 0, last = 0;

  // Um elemento com scroll próprio debaixo do rato ainda pode andar nesta direcção? Então é dele.
  const innerScroll = (el: Element | null, dy: number) => {
    for (; el && el !== document.documentElement && el !== document.body; el = el.parentElement) {
      if (!/(auto|scroll)/.test(getComputedStyle(el).overflowY) || el.scrollHeight <= el.clientHeight) continue;
      if (dy > 0 ? el.scrollTop + el.clientHeight < el.scrollHeight - 1 : el.scrollTop > 0) return true;
    }
    return false;
  };

  const step = (now: number) => {
    // Outra coisa mexeu no scroll entretanto (teclado, barra, link de âncora): deixa-a.
    if (Math.abs(scrollY - current) > 2) { raf = 0; return; }
    const f = Math.min(4, Math.max(0.5, (now - last) / (1000 / 60)));
    last = now;
    current += (target - current) * (1 - Math.pow(0.78, f));
    if (Math.abs(target - current) < 0.5) current = target;
    scrollTo({ top: current, behavior: 'instant' });
    raf = current === target ? 0 : requestAnimationFrame(step);
  };

  addEventListener('wheel', (e) => {
    if (!desktop.matches || e.defaultPrevented || e.ctrlKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return;
    if (document.documentElement.classList.contains('menu-open')) return;
    const dy = e.deltaY * (e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? innerHeight : 1);
    if (innerScroll(e.target as Element, dy)) return;
    e.preventDefault();
    if (!raf) { current = target = scrollY; last = performance.now(); }
    const max = document.documentElement.scrollHeight - innerHeight;
    target = Math.max(0, Math.min(max, target + dy * SPEED));
    if (reduce.matches) { current = target; scrollTo({ top: target, behavior: 'instant' }); return; }
    if (!raf) raf = requestAnimationFrame(step);
  }, { passive: false });
</script>
