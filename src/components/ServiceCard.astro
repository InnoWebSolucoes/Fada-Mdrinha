---
import Icon from './Icon.astro';
import type { Service } from '../data/services';

interface Props { service: Service; href?: string; delay?: number }
const { service, href = `/servicos#${service.id}`, delay = 0 } = Astro.props;
---
<article class="card service-card reveal" style={`--reveal-delay:${delay}s`}>
  <span class:list={['icon-badge', `tone-${service.tone}`]}><Icon name={service.icon} /></span>
  <h3>{service.title}</h3>
  <p>{service.short}</p>
  <a href={href} class="text-link">Ver preços <Icon name="arrow" /></a>
</article>

<style>
  .service-card { display: flex; flex-direction: column; }
  .service-card p { flex: 1; }
  .service-card .text-link { margin-top: 14px; }
</style>
