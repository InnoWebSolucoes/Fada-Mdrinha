---
/** Brilho de fada (estrela de 4 pontas), decorativo. Posicionar com style (top/left, --s, --t). */
interface Props { style?: string; class?: string; color?: string }
const { style, class: className, color } = Astro.props;
---
<svg class:list={['star', 'twinkle', className]} style={`${color ? `color:${color};` : ''}${style ?? ''}`} viewBox="0 0 24 24" aria-hidden="true">
  <path fill="currentColor" d="M12 0c.9 6.6 3.4 9.3 12 12-8.6 2.7-11.1 5.4-12 12-.9-6.6-3.4-9.3-12-12 8.6-2.7 11.1-5.4 12-12Z" />
</svg>
