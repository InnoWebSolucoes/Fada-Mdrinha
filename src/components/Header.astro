---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, waLink } from '../config/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const active = (href: string) => path.startsWith(href);
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Fada Madrinha, página inicial"><Logo height={42} priority /></a>
    <nav class="site-nav" aria-label="Navegação principal">
      {nav.map((i) => <a href={i.href} aria-current={active(i.href) ? 'page' : undefined}>{i.label}</a>)}
    </nav>
    <div class="site-header__cta">
      <a href={waLink()} class="btn btn--sm site-header__btn" target="_blank" rel="noopener">
        <Icon name="whatsapp" /><span class="long">Pedir orçamento</span><span class="short">Orçamento</span>
      </a>
      <button type="button" class="burger" id="menu-btn" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
        <span class="burger__i burger__i--open"><Icon name="menu" size={24} /></span>
        <span class="burger__i burger__i--close"><Icon name="close" size={24} /></span>
      </button>
    </div>
  </div>
</header>

<!-- Fora do <header> para que position:fixed seja relativo ao ecrã. -->
<div class="mobile-menu" id="mobile-menu" hidden>
  <nav class="wrap mobile-menu__nav" aria-label="Navegação móvel">
    <a href="/" aria-current={path === '/' ? 'page' : undefined}>Início</a>
    {nav.map((i) => <a href={i.href} aria-current={active(i.href) ? 'page' : undefined}>{i.label}</a>)}
    <a href="#contacto">Contacto</a>
    <a href={waLink()} class="btn btn--lg" target="_blank" rel="noopener"><Icon name="whatsapp" /> Pedir orçamento</a>
  </nav>
</div>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; isolation: isolate; }
  .site-header::before { content: ''; position: absolute; inset: 0; z-index: -1; background: rgba(250, 250, 246, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: var(--header-h); }
  .site-header__logo { display: inline-flex; flex: none; transition: transform 0.4s var(--bounce); }
  .site-header__logo:hover { transform: rotate(-3deg) scale(1.04); }
  .site-nav { display: none; gap: 4px; }
  .site-nav a { position: relative; padding: 0.55rem 0.9rem; color: var(--navy); font-weight: 500; text-decoration: none; border-radius: var(--r-pill); transition: background-color 0.2s; }
  .site-nav a:hover { background: var(--tint-blue); }
  .site-nav a[aria-current='page'] { background: var(--tint-pink); color: var(--pink-text); }
  .site-header__cta { display: flex; align-items: center; gap: 8px; }
  .long { display: none; }
  .burger { display: inline-grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 2px solid var(--navy); background: var(--white); color: var(--navy); cursor: pointer; }
  .burger__i { display: grid; }
  .burger__i--close { display: none; }
  .burger[aria-expanded='true'] .burger__i--open { display: none; }
  .burger[aria-expanded='true'] .burger__i--close { display: grid; }
  .mobile-menu { position: fixed; inset: 0; top: var(--menu-top, var(--header-h)); z-index: 150; background: var(--tint-blue); overflow-y: auto; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__nav { display: grid; padding-block: 16px 48px; }
  .mobile-menu__nav a:not(.btn) { display: flex; align-items: center; min-height: 64px; font-size: 1.6rem; font-weight: 600; color: var(--navy); text-decoration: none; border-bottom: 2px dashed rgba(11, 53, 86, 0.15); }
  .mobile-menu__nav a[aria-current='page'] { color: var(--pink-text); }
  .mobile-menu__nav .btn { margin-top: 32px; }
  @media (min-width: 520px) { .long { display: inline; } .short { display: none; } }
  @media (min-width: 1060px) { .site-nav { display: flex; } .burger, .mobile-menu { display: none !important; } }
</style>

<script>
  const btn = document.getElementById('menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  const header = document.querySelector('.site-header') as HTMLElement | null;
  if (btn && menu && header) {
    const set = (open: boolean) => {
      menu.style.setProperty('--menu-top', `${Math.max(0, header.getBoundingClientRect().bottom)}px`);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    matchMedia('(min-width: 1060px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
</script>
