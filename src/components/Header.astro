---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, waLink } from '../config/site';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href !== '#contacto' && (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Fada Madrinha — página inicial">
      <Logo variant="light" height={42} priority />
    </a>

    <nav class="site-nav" aria-label="Navegação principal">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="site-header__cta">
      <a href={waLink()} class="btn btn--dark btn--sm site-header__btn" target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Pedir orçamento
      </a>
      <button
        type="button"
        class="burger"
        id="menu-btn"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="burger__open" />
        <Icon name="close" class="burger__close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Navegação móvel" class="wrap mobile-menu__nav">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href={waLink()} class="btn btn--primary btn--block" target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Pedir orçamento
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(250, 250, 246, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .site-header__inner {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    min-height: var(--header-h);
  }
  .site-header__logo { display: inline-flex; flex: none; }
  .site-nav { display: none; gap: 4px; }
  .site-nav a {
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-weight: 500;
    font-size: 0.97rem;
    text-decoration: none;
    transition: background-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .site-nav a:hover { background: rgba(10, 10, 12, 0.06); color: var(--ink); }
  .site-nav a[aria-current='page'] { color: var(--blue-text); background: rgba(13, 141, 229, 0.1); }

  .site-header__cta { display: flex; align-items: center; gap: 10px; }
  .site-header__btn { display: none; }

  .burger {
    display: inline-grid; place-items: center;
    width: 44px; height: 44px;
    border-radius: 12px;
    border: 1px solid var(--line-strong);
    background: var(--white);
    cursor: pointer;
  }
  .burger svg { width: 22px; height: 22px; }
  .burger__close { display: none; }
  .burger[aria-expanded='true'] .burger__open { display: none; }
  .burger[aria-expanded='true'] .burger__close { display: block; }

  .mobile-menu {
    position: fixed; inset: var(--header-h) 0 0 0;
    background: var(--cream);
    overflow-y: auto;
    z-index: 99;
  }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__nav { display: grid; gap: 4px; padding-block: 20px 32px; }
  .mobile-menu__nav a:not(.btn) {
    padding: 0.95rem 0.6rem;
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .mobile-menu__nav a[aria-current='page'] { color: var(--blue-text); }
  .mobile-menu__nav .btn { margin-top: 20px; }

  @media (min-width: 640px) { .site-header__btn { display: inline-flex; } }
  @media (min-width: 1024px) {
    .site-nav { display: flex; }
    .burger, .mobile-menu { display: none !important; }
  }
</style>

<script>
  const btn = document.getElementById('menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); }
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
</script>
