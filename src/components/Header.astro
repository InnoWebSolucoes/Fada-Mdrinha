---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav, waLink } from '../config/site';

interface Props { dark?: boolean }
const { dark = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => href !== '#contacto' && (href === '/' ? path === '/' : path.startsWith(href));
---
<header class:list={['site-header', { 'site-header--dark': dark }]}>
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Fada Madrinha, página inicial">
      <Logo variant={dark ? 'dark' : 'light'} height={40} priority />
    </a>

    <nav class="site-nav" aria-label="Navegação principal">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="site-header__cta">
      <a href={waLink()} class:list={['btn', 'btn--sm', dark ? 'btn--gold' : 'btn--dark', 'site-header__btn']} target="_blank" rel="noopener">
        Pedir orçamento
      </a>
      <button type="button" class="burger" id="menu-btn" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="menu" class="burger__open" />
        <Icon name="close" class="burger__close" />
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Navegação móvel" class="wrap mobile-menu__nav">
      {nav.map((item, i) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          <span class="num">0{i + 1}</span>{item.label}
        </a>
      ))}
      <a href={waLink()} class="btn btn--gold btn--block btn--lg" target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Pedir orçamento
      </a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 100;
    background: rgba(250, 250, 246, 0.9);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }
  .site-header--dark { background: rgba(10, 10, 12, 0.86); border-bottom-color: var(--line-dark); color: var(--cream); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: var(--header-h); }
  .site-header__logo { display: inline-flex; flex: none; }

  .site-nav { display: none; gap: 2px; }
  .site-nav a {
    position: relative; padding: 0.5rem 0.9rem;
    color: inherit; font-weight: 400; font-size: 0.98rem; text-decoration: none;
    transition: color var(--dur) var(--ease);
  }
  .site-nav a::after {
    content: ''; position: absolute; left: 0.9rem; right: 0.9rem; bottom: 2px; height: 1px;
    background: currentColor; transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }
  .site-nav a:hover::after, .site-nav a[aria-current='page']::after { transform: scaleX(1); }
  .site-nav a[aria-current='page'] { color: var(--gold-text); }
  .site-header--dark .site-nav a[aria-current='page'] { color: var(--gold); }

  .site-header__cta { display: flex; align-items: center; gap: 10px; }
  .site-header__btn { display: none; }

  .burger {
    display: inline-grid; place-items: center; width: 44px; height: 44px;
    border-radius: 50%; border: 1px solid var(--line-strong); background: transparent; cursor: pointer; color: inherit;
  }
  .burger svg { width: 22px; height: 22px; }
  .burger__close { display: none; }
  .burger[aria-expanded='true'] .burger__open { display: none; }
  .burger[aria-expanded='true'] .burger__close { display: block; }

  .mobile-menu { position: fixed; inset: var(--header-h) 0 0 0; background: var(--ink); color: var(--cream); overflow-y: auto; z-index: 99; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__nav { display: grid; padding-block: 12px 40px; }
  .mobile-menu__nav a:not(.btn) {
    display: flex; align-items: baseline; gap: 16px;
    padding: 1.05rem 0; font-size: 1.45rem; color: var(--cream); text-decoration: none;
    border-bottom: 1px solid var(--line-dark);
  }
  .mobile-menu__nav a:not(.btn) .num { color: var(--gold-light); }
  .mobile-menu__nav a[aria-current='page'] { color: var(--gold); }
  .mobile-menu__nav .btn { margin-top: 28px; }

  @media (min-width: 640px) { .site-header__btn { display: inline-flex; } }
  @media (min-width: 1024px) { .site-nav { display: flex; } .burger, .mobile-menu { display: none !important; } }
</style>

<script>
  const btn = document.getElementById('menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(menu.hidden));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !menu.hidden) { set(false); btn.focus(); } });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) set(false); });
  }
</script>
