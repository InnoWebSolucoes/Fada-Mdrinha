---
/**
 * Cabeçalho de página interna, no estilo das capas de capítulo do brand book:
 * fundo de cor sólida, numeral grande translúcido, título e citação.
 */
interface Props {
  kicker: string;
  title: string;
  text?: string;
  quote?: string;
  numeral?: string;
  tone?: 'plum' | 'blue-deep' | 'gold-deep' | 'dark' | 'brand';
}
const { kicker, title, text, quote, numeral, tone = 'plum' } = Astro.props;
---
<section class:list={['page-hero', `bg-${tone}`, 'pattern']}>
  <div class="wrap page-hero__inner">
    {numeral && <span class="page-hero__numeral" aria-hidden="true">{numeral}</span>}
    <p class="kicker">{kicker}</p>
    <h1 set:html={title} />
    {text && <p class="lede">{text}</p>}
    {quote && <p class="page-hero__quote">“{quote}”</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(64px, 10vw, 128px) clamp(48px, 7vw, 88px); }
  .page-hero__inner { position: relative; max-width: 820px; }
  .page-hero__numeral {
    display: block;
    font-size: clamp(4rem, 10vw, 7rem);
    line-height: 0.9;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.28);
    margin-bottom: 18px;
    letter-spacing: -0.02em;
  }
  .bg-gold-deep .page-hero__numeral { color: rgba(10, 10, 12, 0.2); }
  .page-hero h1 { color: inherit; }
  .page-hero__quote {
    margin-top: 22px;
    padding-left: 16px;
    border-left: 2px solid var(--gold);
    color: rgba(255, 255, 255, 0.85);
    font-style: italic;
    max-width: 52ch;
  }
  .bg-gold-deep .page-hero__quote { border-color: var(--ink); color: rgba(10, 10, 12, 0.82); }
  .bg-plum .page-hero__quote, .bg-blue-deep .page-hero__quote, .bg-brand .page-hero__quote { border-color: var(--gold-light); }
</style>
