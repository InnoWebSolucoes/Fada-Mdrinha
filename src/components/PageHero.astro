---
/**
 * Cabeçalho de página interna, no estilo das capas de capítulo do brand book:
 * cor sólida, numeral romano em grande, título e citação.
 */
interface Props {
  kicker: string;
  title: string;
  text?: string;
  quote?: string;
  numeral?: string;
  tone?: 'plum' | 'blue-deep' | 'gold-deep' | 'dark' | 'brand';
}
const { kicker, title, text, quote, numeral, tone = 'plum' } = Astro.props;
---
<section class:list={['page-hero', `bg-${tone}`, 'pattern']}>
  <div class="wrap page-hero__inner">
    {numeral && <span class="page-hero__numeral" aria-hidden="true">{numeral}</span>}
    <div class="page-hero__body">
      <p class="kicker">{kicker}</p>
      <h1 set:html={title} />
      {text && <p class="lede">{text}</p>}
      {quote && <p class="page-hero__quote">“{quote}”</p>}
      <slot />
    </div>
  </div>
</section>

<style>
  .page-hero { padding-block: clamp(72px, 10vw, 140px) clamp(56px, 8vw, 104px); }
  .page-hero__inner { display: grid; gap: 24px; }
  .page-hero__numeral {
    font-size: clamp(5rem, 12vw, 9rem); line-height: 0.85; font-weight: 400; letter-spacing: -0.04em;
    color: rgba(255, 255, 255, 0.22);
  }
  .bg-gold-deep .page-hero__numeral { color: rgba(10, 10, 12, 0.16); }
  .page-hero__body { max-width: 820px; }
  .page-hero h1 { color: inherit; }
  .page-hero__quote {
    margin-top: 24px; padding-left: 18px; border-left: 2px solid var(--gold-light);
    color: rgba(255, 255, 255, 0.86); font-style: italic; max-width: 52ch;
  }
  .bg-gold-deep .page-hero__quote { border-color: var(--ink); color: rgba(10, 10, 12, 0.82); }
  @media (min-width: 900px) {
    .page-hero__inner { grid-template-columns: 1fr 5fr; align-items: end; gap: 40px; }
  }
</style>
