---
/** Cabeçalho das páginas internas: cor da página, formas da marca a flutuar e brilhos. */
import Star from './Star.astro';
interface Props { title: string; text?: string; tone?: 'blue' | 'pink' | 'gold' | 'deep' }
const { title, text, tone = 'blue' } = Astro.props;
---
<section class:list={['phero', `phero--${tone}`]}>
  <span class="phero__drop float" aria-hidden="true"></span>
  <span class="phero__circle float" style="--t:-2s" aria-hidden="true"></span>
  <Star style="top:22%;left:6%;--s:22px;--t:.3s" />
  <Star style="bottom:18%;left:42%;--s:14px;--t:1.2s" color="var(--pink)" />
  <div class="wrap phero__inner">
    <h1 class="reveal" set:html={title} />
    {text && <p class="lede reveal" style="--d:1">{text}</p>}
    <slot />
  </div>
</section>

<style>
  .phero { position: relative; overflow: hidden; padding-block: clamp(64px, 9vw, 128px) clamp(56px, 8vw, 104px); }
  .phero--blue { background: var(--tint-blue); }
  .phero--pink { background: var(--tint-pink); }
  .phero--gold { background: var(--tint-gold); }
  .phero--deep { background: var(--blue-deep); color: var(--white); }
  .phero--deep h1 { color: var(--white); }
  .phero--deep .lede { color: rgba(255, 255, 255, 0.88); }
  .phero__inner { position: relative; z-index: 1; }
  .phero h1 { max-width: 16ch; }
  .phero__drop { position: absolute; right: -4%; top: 12%; width: clamp(180px, 28vw, 380px); aspect-ratio: 1; border-radius: 50% 50% 0 50%; background: var(--blue); opacity: 0.9; }
  .phero__circle { position: absolute; right: 22%; bottom: 8%; width: clamp(80px, 11vw, 150px); aspect-ratio: 1; border-radius: 50%; background: var(--pink); }
  .phero--pink .phero__drop { background: var(--pink); }
  .phero--pink .phero__circle { background: var(--gold); }
  .phero--gold .phero__drop { background: var(--gold); }
  .phero--deep .phero__drop { background: var(--blue); }
  .phero--deep .phero__circle { background: var(--pink); }
  @media (max-width: 760px) { .phero__drop { right: -22%; top: 4%; opacity: 0.35; } .phero__circle { right: 6%; bottom: 4%; width: 70px; opacity: 0.6; } }
</style>
