---
interface Props {
  kicker?: string;
  title: string;
  text?: string;
  center?: boolean;
  tone?: 'gold' | 'blue' | 'pink';
  as?: 'h1' | 'h2' | 'h3';
  class?: string;
}
const { kicker, title, text, center = false, tone = 'gold', as: Tag = 'h2', class: className } = Astro.props;
---
<div class:list={['section-head', { 'section-head--center': center }, className]}>
  {kicker && <p class:list={['kicker', { 'kicker--center': center, 'kicker--blue': tone === 'blue', 'kicker--pink': tone === 'pink' }]}>{kicker}</p>}
  <Tag set:html={title} />
  {text && <p>{text}</p>}
  <slot />
</div>
