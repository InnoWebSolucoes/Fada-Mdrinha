---
import { site, waLink } from '../config/site';
import Star from './Star.astro';
---
<div class="announce">
  <div class="wrap announce__inner">
    <Star style="position:relative;--s:14px;--t:.2s" color="var(--gold)" />
    <p>{site.announcement} <a href={waLink()} target="_blank" rel="noopener">Peça já o seu orçamento</a></p>
    <Star style="position:relative;--s:14px;--t:1.1s" color="var(--pink)" />
  </div>
</div>

<style>
  .announce { background: var(--navy); color: var(--white); font-size: 0.92rem; }
  .announce__inner { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 42px; padding-block: 8px; text-align: center; }
  .announce p { margin: 0; }
  .announce a { color: var(--gold); font-weight: 600; }
  .announce a:hover { color: var(--white); }
</style>
